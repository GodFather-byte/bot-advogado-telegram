# Bot Advogado Telegram
TELEGRAM_BOT_TOKEN=
# Segredo do webhook do Telegram (opcional, recomendado em produção).
# Deve ser o mesmo valor configurado com setWebhook (secret_token).
# Sem esta variável, o webhook funciona em modo de compatibilidade (sem validação).
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
MONGODB_URI=
PORT=3000
# Modelo padrão estável do Gemini. Ajuste conforme o acesso da sua conta.
GEMINI_MODEL=gemini-1.5-flash
HISTORY_LIMIT=20
MAX_PDF_CHARACTERS=30000
ADMIN_USER_IDS=
# Chave do painel admin. Prefira enviá-la via header x-admin-key.
# O uso via query string (?key=...) é mantido apenas por retrocompatibilidade.
ADMIN_PANEL_KEY=
PUBLIC_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_MS=60000
BOT_NAME=Assistente Jurídico
